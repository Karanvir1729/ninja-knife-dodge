[sub_resource type="Shader" id="vignette"]
code = "shader_type canvas_item;

uniform vec4 tint : source_color = vec4(1.0, 0.847, 0.302, 1.0);
uniform float strength : hint_range(0.0, 1.0) = 0.0;

void fragment() {
	vec2 d = UV - vec2(0.5);
	float v = smoothstep(0.15, 0.85, length(d) * 1.4);
	COLOR = vec4(tint.rgb, (0.18 + 0.82 * v) * strength);
}"

